{
  "name": "team-member-showcasing",
  "version": "1.0.0",
  "description": "A website for showcasing team members and their skills",
  "type": "module",
  "scripts": {
    "start": "json-server --watch db.json --host 0.0.0.0 --port $PORT",
    "test": "mocha --recursive tests",
    "coverage": "c8 --all --include=\"src/**/*.js\" --check-coverage --lines 50 --functions 50 --branches 50 --statements 50 --reporter=text --reporter=html mocha --recursive tests",
    "lint": "eslint src tests"
  },
  "keywords": [
    "team",
    "showcase",
    "javascript",
    "json-server"
  ],
  "author": "Nacima Muhidin",
  "license": "MIT",
  "devDependencies": {
    "c8": "^12.0.0",
    "chai": "^4.5.0",
    "eslint": "^8.57.1",
    "jsdom": "^30.1.3",
    "json-server": "0.17.4",
    "mocha": "^10.8.2",
    "nyc": "^15.1.0"
  }
}
